# Copy to .env and adjust. The values below are for local development only.
POSTGRES_DB=tech_wise_academy
POSTGRES_USER=tech_wise
POSTGRES_PASSWORD=change-me-locally
# Host port of the database for tools outside Docker (e.g. a DB client)
POSTGRES_PORT=55432
# Folder with the embedding model (ADR-0006), mounted into the backend container. Download once:
#   https://huggingface.co/sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   files onnx/model_quint8_avx2.onnx (118.5 MB) and tokenizer.json, both into this folder
EMBEDDING_MODEL_HOST_DIR=D:/models/paraphrase-multilingual-MiniLM-L12-v2

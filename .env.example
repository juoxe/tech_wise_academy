# Copy to .env and adjust. The values below are for local development only.
POSTGRES_DB=tech_wise_academy
POSTGRES_USER=tech_wise
POSTGRES_PASSWORD=change-me-locally
# Host port of the database for tools outside Docker (e.g. a DB client)
POSTGRES_PORT=55432
# Host port of the local embedding service (Ollama, ADR-0006)
OLLAMA_PORT=11434
# Embedding service and model. Point EMBEDDING_URL at another machine in the local network to use its GPU.
# EMBEDDING_URL=http://ollama:11434
# EMBEDDING_MODEL=bge-m3

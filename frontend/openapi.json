  "components": {
    "schemas": {
      "AlternativeOut": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "key",
          "name"
        ],
        "title": "AlternativeOut"
      },
      "AnswerIn": {
        "properties": {
          "game": {
            "type": "string",
            "enum": [
              "level0",
              "clearing"
            ],
            "title": "Game"
          },
          "tool_key": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9-]+$",
            "title": "Tool Key"
          },
          "correct": {
            "type": "boolean",
            "title": "Correct"
          }
        },
        "type": "object",
        "required": [
          "game",
          "tool_key",
          "correct"
        ],
        "title": "AnswerIn"
      },
      "Category": {
        "type": "string",
        "enum": [
          "DEVOPS",
          "BACKEND",
          "FRONTEND",
          "SECURITY",
          "AI_DATA",
          "OBJECT_ORIENTED",
          "FUNCTIONAL",
          "PROCEDURAL",
          "DECLARATIVE",
          "MULTI_PARADIGM"
        ],
        "title": "Category"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InterviewCardOut": {
        "properties": {
          "tool_key": {
            "type": "string",
            "title": "Tool Key"
          },
          "similarity": {
            "type": "number",
            "title": "Similarity"
          },
          "mentioned": {
            "type": "boolean",
            "title": "Mentioned"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "tool_key",
          "similarity",
          "mentioned",
          "evidence"
        ],
        "title": "InterviewCardOut"
      },
      "InterviewSetIn": {
        "properties": {
          "job_ad": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 50,
            "title": "Job Ad"
          }
        },
        "type": "object",
        "required": [
          "job_ad"
        ],
        "title": "InterviewSetIn"
      },
      "InterviewSetOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          },
          "cards": {
            "items": {
              "$ref": "#/components/schemas/InterviewCardOut"
            },
            "type": "array",
            "title": "Cards"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "embedding_model",
          "cards"
        ],
        "title": "InterviewSetOut"
      },
      "InterviewSetSummaryOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "card_count": {
            "type": "integer",
            "title": "Card Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "card_count"
        ],
        "title": "InterviewSetSummaryOut"
      },
      "KeyConceptOut": {
        "properties": {
          "term": {
            "type": "string",
            "title": "Term"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "term",
          "explanation"
        ],
        "title": "KeyConceptOut"
      },
      "PrioritiesIn": {
        "properties": {
          "tool_keys": {
            "items": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9][a-z0-9._+#-]*$"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Tool Keys"
          },
          "score": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "tool_keys",
          "score"
        ],
        "title": "PrioritiesIn",
        "description": "One score for several tools: a single tool, an area or a whole tech stack."
      },
      "PriorityOut": {
        "properties": {
          "tool_key": {
            "type": "string",
            "title": "Tool Key"
          },
          "score": {
            "type": "integer",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "tool_key",
          "score"
        ],
        "title": "PriorityOut",
        "description": "A tool with a score that differs from the default."
      },
      "ProgressOut": {
        "properties": {
          "tool_key": {
            "type": "string",
            "title": "Tool Key"
          },
          "correct_in_a_row": {
            "type": "integer",
            "title": "Correct In A Row"
          },
          "learned": {
            "type": "boolean",
            "title": "Learned"
          },
          "correct_total": {
            "type": "integer",
            "title": "Correct Total"
          },
          "wrong_total": {
            "type": "integer",
            "title": "Wrong Total"
          }
        },

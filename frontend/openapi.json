{
  "openapi": "3.1.0",
  "info": {
    "title": "Tech Wise Academy",
    "version": "0.1.0"
  },
  "paths": {
    "/api/tools": {
      "get": {
        "tags": [
          "tools"
        ],
        "summary": "List Tools",
        "operationId": "list_tools_api_tools_get",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "const": "de",
              "type": "string",
              "default": "de",
              "title": "Lang"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ToolSummaryOut"
                  },
                  "title": "Response List Tools Api Tools Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tools/{key}": {
      "get": {
        "tags": [
          "tools"
        ],
        "summary": "Get Tool",
        "operationId": "get_tool_api_tools__key__get",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Key"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "const": "de",
              "type": "string",
              "default": "de",
              "title": "Lang"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolDetailOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/training/answers": {
      "post": {
        "tags": [
          "training"
        ],
        "summary": "Record Answer",
        "operationId": "record_answer_api_training_answers_post",
        "parameters": [
          {
            "name": "X-Profile-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Profile-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/training/progress": {
      "get": {
        "tags": [
          "training"
        ],
        "summary": "List Progress",
        "operationId": "list_progress_api_training_progress_get",
        "parameters": [
          {
            "name": "game",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "level0",
                "clearing"
              ],
              "type": "string",
              "title": "Game"
            }
          },
          {
            "name": "X-Profile-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Profile-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProgressOut"
                  },
                  "title": "Response List Progress Api Training Progress Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlternativeOut": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "key",
          "name"
        ],
        "title": "AlternativeOut"
      },
      "AnswerIn": {
        "properties": {
          "game": {
            "type": "string",
            "enum": [
              "level0",
              "clearing"
            ],
            "title": "Game"
          },
          "tool_key": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9-]+$",
            "title": "Tool Key"
          },
          "correct": {
            "type": "boolean",
            "title": "Correct"
          }
        },
        "type": "object",
        "required": [
          "game",
          "tool_key",
          "correct"
        ],
        "title": "AnswerIn"
      },
      "Category": {
        "type": "string",
        "enum": [
          "DEVOPS",
          "BACKEND",
          "FRONTEND",
          "SECURITY",
          "AI_DATA",
          "OBJECT_ORIENTED",
          "FUNCTIONAL",
          "PROCEDURAL",
          "DECLARATIVE",
          "MULTI_PARADIGM"
        ],
        "title": "Category"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProgressOut": {
        "properties": {
          "tool_key": {
            "type": "string",
            "title": "Tool Key"
          },
          "correct_in_a_row": {
            "type": "integer",
            "title": "Correct In A Row"
          },
          "learned": {
            "type": "boolean",
            "title": "Learned"
          },
          "correct_total": {
            "type": "integer",
            "title": "Correct Total"
          },
          "wrong_total": {
            "type": "integer",
            "title": "Wrong Total"
          }
        },
        "type": "object",
        "required": [
          "tool_key",
          "correct_in_a_row",
          "learned",
          "correct_total",
          "wrong_total"
        ],
        "title": "ProgressOut"
      },
      "ToolDetailOut": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "level": {
            "type": "integer",
            "title": "Level"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "documentation_url": {
            "type": "string",
            "title": "Documentation Url"
          },
          "hints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hints"
          },
          "examples": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Examples"
          },
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/AlternativeOut"
            },
            "type": "array",
            "title": "Alternatives"
          }
        },
        "type": "object",
        "required": [
          "key",
          "name",
          "category",
          "level",
          "summary",
          "language",
          "icon",
          "documentation_url",
          "hints",
          "examples",
          "alternatives"
        ],
        "title": "ToolDetailOut"
      },
      "ToolSummaryOut": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "level": {
            "type": "integer",
            "title": "Level"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          }
        },
        "type": "object",
        "required": [
          "key",
          "name",
          "category",
          "level",
          "summary",
          "language",
          "icon"
        ],
        "title": "ToolSummaryOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}